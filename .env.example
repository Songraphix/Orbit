# Copy to .env.local and fill in from Firebase Console → Project settings → Your apps (Web).
# These identify the project; they are not secrets (Security Rules protect the data).
MAIN_VITE_FIREBASE_API_KEY=
MAIN_VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
MAIN_VITE_FIREBASE_PROJECT_ID=your-project
MAIN_VITE_FIREBASE_APP_ID=
# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Desktop app. Google treats a desktop client's secret as non-confidential, but keep it here.
MAIN_VITE_GOOGLE_DESKTOP_CLIENT_ID=
MAIN_VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
